# Copy this file to .env and fill in real values before running the app.

# Postgres connection string (Vercel Postgres / Supabase / Neon / Railway...).
# See README "Database setup" for how to get one for free in a few minutes.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth / Auth.js secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Public site URL — used for canonical links, sitemap.xml, robots.txt,
# Open Graph tags and JSON-LD. Set to the real domain once connected.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Site branding shown across the app (nav, footer, metadata).
NEXT_PUBLIC_SITE_NAME="EventHub"

# Credentials used by `npm run db:seed` to create the first Super Admin user.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
