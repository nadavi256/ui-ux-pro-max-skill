# Postgres connection string (Neon / Supabase / Vercel Postgres).
# On Vercel, POSTGRES_PRISMA_URL / POSTGRES_URL are also picked up automatically.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Random secret for signing session cookies: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""

# Public site URL (used for SEO metadata / sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
